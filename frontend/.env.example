# Set to false to connect to the real Spring Boot backend (which connects to Supabase)
NEXT_PUBLIC_USE_MOCK_API=false

# Spring Boot Backend API Base URL (public fallback & server-side proxy target)
NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_INTERNAL_URL=http://localhost:8080

# Google OAuth 2.0 Web Client ID (used by @react-oauth/google & native Capacitor SocialLogin)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
