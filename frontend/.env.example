# Turn Mock Data Mode ON or OFF:
# - false: Connects directly to live Spring Boot backend & Supabase Cloud PostgreSQL 17 (Default)
# - true: Uses local mock data simulation for UI testing without running backend
NEXT_PUBLIC_USE_MOCK_API=false

# Spring Boot Backend API Base URL (used when NEXT_PUBLIC_USE_MOCK_API is false)
NEXT_PUBLIC_API_URL=http://localhost:8080
