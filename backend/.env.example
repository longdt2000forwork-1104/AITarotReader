# ==============================================================================
# SUPABASE FREE TIER CONFIGURATION FOR AI TAROT READER
# ==============================================================================
# In your Supabase Dashboard:
# 1. Go to: Project Settings -> Database
# 2. Look for "Connection string" section and select "JDBC" or "URI"
#
# Option A: Connection Pooler (RECOMMENDED by Supabase for serverless & cloud)
# Host: aws-0-[REGION].pooler.supabase.com, Port: 6543 (Transaction) or 5432 (Session)
# Username: postgres.[YOUR-PROJECT-REF]
#
# Option B: Direct Connection
# Host: db.[YOUR-PROJECT-REF].supabase.co, Port: 5432
# Username: postgres
# ==============================================================================

# Active Spring Profile
SPRING_PROFILES_ACTIVE=supabase

# Database JDBC URL
# Example Direct:
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require
# Example Pooler (Session mode):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Database User & Password
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# JWT Secret for Auth Token signing
JWT_SECRET=4c9b83b8e4e73b499120612948c21a367d2645f7823b49826a3c617b32817d23f6e1239841

# Optional: Google Gemini API Key for dynamic reading interpretations
GEMINI_API_KEY=
