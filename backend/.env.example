SPRING_PROFILES_ACTIVE=supabase
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=your-supabase-username
SPRING_DATASOURCE_PASSWORD=your-supabase-password

# Mandatory JWT secret (minimum 32 bytes / 256 bits)
JWT_SECRET=replace-with-at-least-64-hex-or-random-characters-for-hs256
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Google OAuth2 Client IDs (comma-separated: Web Client ID, Android Client ID)
GOOGLE_CLIENT_IDS=

# Gmail SMTP for email verification & password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
MAIL_FROM=AI Tarot Reader <your-gmail@gmail.com>
FRONTEND_BASE_URL=http://localhost:3000

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
